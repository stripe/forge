{
  "name": "@stripe/forge",
  "version": "1.0.0",
  "description": "Portable execution harness for reproducible coding-agent evaluations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stripe/forge.git"
  },
  "homepage": "https://github.com/stripe/forge#readme",
  "bugs": {
    "url": "https://github.com/stripe/forge/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.6.0",
  "bin": {
    "forge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atif": {
      "types": "./dist/atif/index.d.ts",
      "import": "./dist/atif/index.js"
    },
    "./atif/v1.8": {
      "types": "./dist/atif/index.d.ts",
      "import": "./dist/atif/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./experiment": {
      "types": "./dist/experiment.d.ts",
      "import": "./dist/experiment.js"
    },
    "./regrade": {
      "types": "./dist/regrade/index.d.ts",
      "import": "./dist/regrade/index.js"
    },
    "./experiment/cli": {
      "types": "./dist/experimentCli.d.ts",
      "import": "./dist/experimentCli.js"
    },
    "./agents/claude-code": {
      "types": "./dist/agents/claude-code/index.d.ts",
      "import": "./dist/agents/claude-code/index.js"
    },
    "./agents/codex": {
      "types": "./dist/agents/codex/index.d.ts",
      "import": "./dist/agents/codex/index.js"
    },
    "./agents/opencode": {
      "types": "./dist/agents/opencode/index.d.ts",
      "import": "./dist/agents/opencode/index.js"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic/index.d.ts",
      "import": "./dist/providers/anthropic/index.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai/index.d.ts",
      "import": "./dist/providers/openai/index.js"
    },
    "./runtime/docker": {
      "types": "./dist/runtime/docker/index.d.ts",
      "import": "./dist/runtime/docker/index.js"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "import": "./dist/setup/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/build-info.mjs",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "check:docs": "pnpm build && pnpm check:docs:built",
    "check:docs:built": "node scripts/check-docs.mjs",
    "check:cases": "pnpm build && pnpm check:cases:built",
    "check:cases:built": "node scripts/check-cases.mjs",
    "check:package": "publint && pnpm test:types && pnpm test:package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:live": "pnpm build && node scripts/live-e2e.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:cases:built && pnpm check:docs:built && pnpm check:package",
    "test:package": "node scripts/package-smoke.mjs",
    "test:types": "attw --pack . --profile esm-only",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "toml": "5.0.0",
    "yaml": "^2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.15.30",
    "esbuild": "0.28.2",
    "publint": "^0.3.12",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  }
}
